# Build output. Produced by this repo's own Makefile:
#   /bin/    - `make build`         -> bin/tapelibrary_exporter
#   /linux/  - `make docker-build`  -> linux/<arch>/tapelibrary_exporter staging
#              dir for the release image (self-removed on success; kept here
#              as a safety net for a failed/interrupted run).
/bin/
/linux/

# GoReleaser's output directory. docs/release-process.md's step 9 suggests
# running `goreleaser release --clean` (or --snapshot) locally when there is no
# forge to do it, and that writes every cross-compiled archive, checksum and
# SBOM here.
/dist/

# CycloneDX SBOM for the container image, produced by `make sbom-image`
# (glob future-proofs against any syft output name, not just today's
# <name>.image.cdx.json).
*.cdx.json

# Go test/coverage artifacts. No Makefile target produces these today, but
# they are the standard names `go test -coverprofile=...` / `go test -c`
# write to when run by hand or wired into CI later.
*.out
coverage.*
*.test

# Raw material gathered from the monitored target: captured output and the
# target's own API documentation. Ignored because it is NOT anonymized and
# may carry real hostnames, tenants or credentials, and because third-party
# documentation carries redistribution terms this repository does not decide.
# The README is kept tracked so the directory survives a clone: git does not
# track empty directories. See samples/README.md.
/samples/*
!/samples/README.md

# The real instance list, made by copying config.example.yml. It holds the
# addresses of an actual fleet and, if basic_auth is enabled inline rather
# than via password_file, its credentials. Both compose files mount this
# path, so it is the name everyone ends up creating - which is exactly why
# it must never be committable. config.example.yml stays tracked.
/config.yml

.DS_Store
